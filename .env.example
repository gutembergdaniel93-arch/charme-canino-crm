# ===========================================
# CRM AI-First — Variaveis de Ambiente
# ===========================================
# Copie este arquivo pra .env e preencha:
#   cp .env.example .env
#
# O Claude Code preenche automaticamente na ETAPA 6 do onboarding.
# ===========================================

# Supabase (OBRIGATORIO)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Alias legado removido: o frontend usa somente VITE_SUPABASE_ANON_KEY.

# URL do app (nao alterar pra dev local)
VITE_APP_URL=http://localhost:8080

# URL pública do CRM usada no build da extensão
VITE_CRM_URL=http://localhost:8080

# Token público e aleatório do link /agendar (gerado pelo setup)
VITE_BOOKING_PUBLIC_TOKEN=

# Integração opcional com uma área de membros externa
VITE_PAIN_AREA_MEMBROS_URL=
VITE_PAIN_API_KEY=

# Feature flags (opcional)
VITE_COCKPIT_V2=true
