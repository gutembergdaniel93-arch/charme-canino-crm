# ═══════════════════════════════════════════════════════════════════════════
# LiveKit Acelerador — Variáveis de ambiente
# ═══════════════════════════════════════════════════════════════════════════
# Copiar como .env e preencher. Depois configurar cada variável no Supabase
# via: `npx supabase secrets set --project-ref <SEU_REF> KEY=value`

# ─── SUPABASE ───
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co       # pro frontend
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...                    # pro frontend
VITE_CRM_URL=https://seu-crm.vercel.app
CRM_PUBLIC_ORIGIN=https://seu-crm.vercel.app

# ─── LIVEKIT CLOUD ───
# Criar conta em https://cloud.livekit.io → projeto → Settings → API Keys
LIVEKIT_URL=https://SEU-PROJETO.livekit.cloud           # HTTPS (pro webhook do server-side)
LIVEKIT_WS_URL=wss://SEU-PROJETO.livekit.cloud          # WebSocket (pro client)
LIVEKIT_API_KEY=APIxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxx

# ─── CLOUDFLARE R2 ───
# Criar conta em https://dash.cloudflare.com/?to=/:account/r2
# 1. Criar bucket "meeting-recordings"
# 2. Habilitar Public Access → copiar Public URL (pub-xxxxx.r2.dev)
# 3. R2 → Manage API Tokens → Create API Token (Object Read & Write, único bucket)
R2_ACCESS_KEY_ID=xxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxx
R2_BUCKET=meeting-recordings
R2_ENDPOINT=https://SEU-ACCOUNT-ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-XXXXXXXX.r2.dev

# ─── DEEPGRAM (transcrição ao vivo) ───
# https://console.deepgram.com → API Keys
DEEPGRAM_API_KEY=xxxxxxxxxxx

# ─── ASSEMBLYAI (recovery pós-call, opcional) ───
# https://www.assemblyai.com → API Key
ASSEMBLYAI_API_KEY=xxxxxxxxxxx

# ─── LLM (análise IA pós-mentoria, escolha 1) ───
# https://console.anthropic.com  OU  https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...

# ─── SISTEMA EXTERNO (opcional — LMS onde alunos veem gravação) ───
EXTERNAL_WEBHOOK_URL=https://outro-sistema.com/webhook
EXTERNAL_WEBHOOK_TOKEN=xxxxxxxxxxx

# ─── MODAL WORKER (concat de gravações longas, opcional) ───
# https://modal.com → sign up
RECORDING_CONCAT_URL=https://SEU-USUARIO--recording-concat-concat.modal.run
